# Development placeholders only. Never commit real credentials.
OPEN_FLOW_HTTP_ADDR=127.0.0.1:8080
OPEN_FLOW_LOG_LEVEL=info
OPEN_FLOW_TEMPORAL_ADDRESS=127.0.0.1:7233
OPEN_FLOW_TEMPORAL_NAMESPACE=default
OPEN_FLOW_TEMPORAL_TASK_QUEUE=open-flow-media
OPEN_FLOW_KAFKA_BROKER=127.0.0.1:9092
OPEN_FLOW_DATABASE_URL=postgres://open_flow:local-development-only@127.0.0.1:5432/open_flow?sslmode=disable
# Optional: isolated schemas for Go PostgreSQL integration tests.
# OPEN_FLOW_TEST_DATABASE_URL=postgres://open_flow:local-development-only@127.0.0.1:5432/open_flow?sslmode=disable
POSTGRES_DB=open_flow
POSTGRES_USER=open_flow
POSTGRES_PASSWORD=local-development-only
# M1 will add credential encryption/owner authorization after implementing validation.
# Do not put provider keys in NEXT_PUBLIC_* variables.
# Generate these with pnpm setup:local. Do not commit .env.
OPEN_FLOW_OWNER_TOKEN=
OPEN_FLOW_OWNER_ID=00000000-0000-4000-8000-000000000001
OPEN_FLOW_ENCRYPTION_KEYS=
OPEN_FLOW_ENCRYPTION_VERSION=1
OPEN_FLOW_S3_ENDPOINT=http://127.0.0.1:8333
OPEN_FLOW_S3_REGION=us-east-1
OPEN_FLOW_S3_BUCKET=open-flow-private
OPEN_FLOW_S3_ACCESS_KEY=
OPEN_FLOW_S3_SECRET_KEY=
OPEN_FLOW_API_URL=http://127.0.0.1:8080
OPEN_FLOW_SECURE_COOKIE=false
# Optional: your local ComfyUI installation, never a client-supplied endpoint.
OPEN_FLOW_COMFYUI_ENDPOINT=
